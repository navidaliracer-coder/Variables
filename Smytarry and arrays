# Set A
set1_a = {'blue', 'green'}
set2_a = {'blue', 'yellow'}

# Set B
set1_b = {1, 2, 3, 4, 5}
set2_b = {1, 5, 6, 7, 8, 9}

# Symmetric differences
result_a = set1_a.symmetric_difference(set2_a)
result_b = set1_b.symmetric_difference(set2_b)

# Print results
print("Symmetric Difference (A):", result_a)
print("Symmetric Difference (B):", result_b)